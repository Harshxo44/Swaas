# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000

# Firebase Admin SDK
# Option 1: Paste the full JSON string of your serviceAccountKey.json here (for production/cloud)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option 2: Leave blank and place serviceAccountKey.json in this /backend directory (for local dev)

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# FCM Server Key (Legacy, for direct HTTP if needed)
# FCM_SERVER_KEY=your-fcm-server-key
